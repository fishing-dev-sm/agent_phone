# Copy the names you need into your shell or .env (gitignored). Do not commit values.

# --- Speech service (OpenAI-compatible, self-hosted SenseVoice + Kokoro) ---
SPEECH_API_KEY=
HT802_TTS_ENDPOINT=http://192.168.1.20:8300/v1/audio/speech
HT802_TTS_MODEL=kokoro-82M
HT802_TTS_VOICE=zf_xiaoxiao
HT802_STT_ENDPOINT=http://192.168.1.20:8300/v1/audio/transcriptions
HT802_STT_MODEL=SenseVoice-Small

# --- Telephony ---
HT802_LOCAL_ADDRESS=192.168.1.10
HT802_ADDRESS=192.168.1.150
HT802_SIP_PORT=5090
HT802_DEVICE_SIP_PORT=5060
HT802_RTP_PORT=15004

# --- Device provisioning (only for ht802-configure.py) ---
HT802_PASSWORD=
HT802_EXPECTED_MAC=

# Optional provider pinning: openai | glm (auto-detected from keys when unset)
#HT802_TTS_PROVIDER=
#HT802_STT_PROVIDER=

# --- Speech compression for long reports (optional; falls back to truncation) ---
# Any OpenAI-compatible chat endpoint works, e.g. a LiteLLM proxy in front of llama.cpp.
#PHONE_CHAT_ENDPOINT=http://192.168.1.20:8090/v1/chat/completions
#PHONE_CHAT_MODEL=qwen3.8
#PHONE_CHAT_KEY=
#HT802_STT_MAX_SECONDS=115
